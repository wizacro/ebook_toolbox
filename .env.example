# Z-Library account configuration
# Fill either email/password or remix token credentials.

ZLIBRARY_EMAIL=your_email@example.com
ZLIBRARY_PASSWORD=your_password

# Optional: if you already have remix tokens, you can use these instead.
ZLIBRARY_REMIX_USERID=
ZLIBRARY_REMIX_USERKEY=

# ---- The following are optional; all editable in the Web console "域名与路径配置" panel ----

# Z-Library mirror domain. If downloads stop working, open a booklist page in your
# browser and set this to the domain that works.
ZLIBRARY_DOMAIN=zh.zlib.bz

# Booklist download destination / local library root / default collect output directory.
BOOKLIST_SAVE_DIR=E:\zlibrary_booklists
LOCAL_LIBRARY_DIR=E:\
LOCAL_OUTPUT_DIR=E:\书单

# Scan the local library index before downloading a booklist (true/false).
BOOKLIST_USE_LOCAL_INDEX=false
